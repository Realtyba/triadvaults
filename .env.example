# Copia este fichero a `.env`, o deja que `npm run dev` lo genere por ti
# (lo hace `scripts/setup-env.js`, que además inventa un JWT_SECRET al azar).

# --- Servidor ---
PORT=3001

# Clave de firma de los JWT (sesión HTTP y handshake de socket).
# Obligatoria en producción: sin ella se usa una clave de desarrollo conocida.
JWT_SECRET=cambia_esta_clave_por_una_larga_y_aleatoria

# --- Cliente (Vite) ---
VITE_API_URL=http://localhost:3001

# --- PostgreSQL ---
# Alternativa a las variables sueltas de abajo; si se define, manda esta.
# DATABASE_URL=postgres://postgres:clave@localhost:5432/triadvaults
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=triadvaults

# Con `true` el servidor se niega a arrancar si no puede conectar, en vez de caer
# al respaldo local `server/data/users.json`. Se activa solo en producción.
# DB_REQUIRED=true

# --- Correo (Nodemailer) ---
# Se dejan vacíos a propósito: unas credenciales de relleno pasan por buenas y el
# envío falla en silencio. Vacío = "sin correo", que es un estado manejado.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Triad Vaults" <noreply@triadvaults.com>

# Sin SMTP configurado, el PIN de verificación solo se imprime en la consola del
# servidor. Con esto en `true` viaja también en la respuesta para poder probar el
# registro sin montar correo. Se ignora si NODE_ENV=production.
AUTH_DEV_ECHO_PIN=true

# --- Pruebas e2e (opcional) ---
# Ruta a un Chrome propio; si se omite se usa el de la caché de Playwright.
# CHROME_PATH=/usr/bin/google-chrome
