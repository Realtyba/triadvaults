# Copia este fichero a `.env`, o deja que `npm run dev` lo genere por ti
# (lo hace `scripts/setup-env.js`).
#
# Este servidor solo coordina salas. Las cuentas, el progreso, los logros y el
# correo viven en realtyba-api, así que aquí no hay ni base de datos ni SMTP.

# --- Servidor de salas ---
PORT=3001

# --- Integración con realtyba-api ---
# Dónde vive la API de cuentas, para TODO el que la use: el servidor la lee de aquí
# para reportar el progreso, y el cliente la recibe horneada por `vite.config.js`
# para el resto (registro, login, perfil, clasificación).
#
# Es la raíz del servicio, SIN sufijo de ruta: cada quien añade el suyo
# (`/api/triadvaults/...`). Un `/api/v1` aquí lo rompe todo — ese prefijo es el del
# panel admin, que consume realtyba-front, no el juego.
TRIADVAULTS_API_URL=http://localhost:8000

# Secreto de servicio a servicio (cabecera X-Internal-Secret) con el que este
# servidor reporta el progreso. MISMO valor que TRIADVAULTS_INTERNAL_SECRET en el
# .env de realtyba-api.
TRIADVAULTS_INTERNAL_SECRET=

# Firma HS256 del token de jugador. Lo EMITE Laravel al iniciar sesión y aquí solo
# se verifica, así que tiene que ser el MISMO valor que TRIADVAULTS_JWT_SECRET en
# realtyba-api. Mínimo 32 bytes: `openssl rand -hex 32`.
# Sin él, el servidor se niega a arrancar.
TRIADVAULTS_JWT_SECRET=

# --- Cliente (Vite) ---
# Solo el socket. La URL de la API NO se repite aquí: sale de TRIADVAULTS_API_URL.
VITE_SOCKET_URL=http://localhost:3001

# --- Pruebas e2e (opcional) ---
# Ruta a un Chrome propio; si se omite se usa el de la caché de Playwright.
# CHROME_PATH=/usr/bin/google-chrome
