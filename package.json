{
  "name": "triad-vaults",
  "version": "1.0.0",
  "description": "Procedural 3-Player Co-op Cyberpunk Puzzle Escape Game",
  "homepage": "https://triadvaults.invalid",
  "desktopName": "triad-vaults.desktop",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "predev": "node scripts/setup-env.js",
    "dev": "concurrently \"vite\" \"node server/index.js\"",
    "build": "vite build",
    "server": "node server/index.js",
    "setup:env": "node scripts/setup-env.js",
    "assets": "node scripts/fetch-assets.mjs",
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "predist": "rm -rf release",
    "predist:win": "rm -rf release",
    "predist:linux": "rm -rf release",
    "predist:mac": "rm -rf release",
    "dist": "npm run icon && npm run build && electron-builder --publish never",
    "dist:win": "npm run icon && npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run icon && npm run build && electron-builder --linux --publish never",
    "dist:mac": "npm run icon && npm run build && electron-builder --mac --publish never",
    "validate:levels": "node scripts/validate-levels.js",
    "validate:puzzles": "node scripts/validate-puzzles.js",
    "validate:movement": "node scripts/validate-movement.js",
    "validate:achievements": "node scripts/validate-achievements.js",
    "validate:rooms": "node scripts/test-rooms.js",
    "validate:leaks": "node scripts/check-leaks.js",
    "validate": "npm run validate:levels && npm run validate:puzzles && npm run validate:movement && npm run validate:achievements && npm run validate:rooms && npm run validate:leaks",
    "test:e2e": "node scripts/e2e/run.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "three": "^0.166.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "electron": "^31.2.0",
    "electron-builder": "26.15.3",
    "vite": "^5.3.4"
  },
  "optionalDependencies": {
    "steamworks.js": "0.4.0"
  }
}
